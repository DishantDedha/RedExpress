# =============================================================================
# Red Express — master environment reference
# =============================================================================
# This file is the single list of every variable the three apps use. It is NOT
# loaded by anything directly. Copy the section you need into the app's own file:
#
#   [backend]  ->  backend/.env       (loaded by dotenv)
#   [mobile]   ->  mobile/.env        (Expo; only EXPO_PUBLIC_* reach the app)
#   [crm]      ->  crm/.env.local     (Next.js; only NEXT_PUBLIC_* reach the browser)
#
# Never commit a filled-in .env. Only this .example file is tracked.
#
# WARNING: anything prefixed EXPO_PUBLIC_ or NEXT_PUBLIC_ is embedded in the
# client bundle and is readable by anyone who has the app. Secrets never go there.
# =============================================================================


# -----------------------------------------------------------------------------
# [backend] Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public base URL of the API. Used to build absolute URLs for uploaded files.
API_BASE_URL=http://localhost:4000
# Comma-separated browser origins allowed to call this API. An allow-list, never "*".
# In production this is locked to the CRM origin only, and an EMPTY value means
# "reject every cross-origin browser request" — it does not mean "allow all".
# The mobile app is unaffected: React Native's fetch sends no Origin header.
CORS_ORIGINS=http://localhost:3000

# Express "trust proxy". Rate limiting keys on the client IP, which behind a load
# balancer is only visible in X-Forwarded-For.
#   unset/false  no proxy — use the socket address (correct for local + bare Node)
#   1            exactly one proxy in front (typical: Nginx, Render, Fly, Railway)
#   2            two hops (e.g. Cloudflare -> platform router)
# Getting this wrong is a real bug in both directions: too low and every caller
# shares one bucket; too high and a client can spoof its own IP for a fresh one.
TRUST_PROXY=

# Largest JSON/urlencoded body accepted. Multipart uploads are capped separately
# by MAX_UPLOAD_BYTES below.
JSON_BODY_LIMIT=100kb


# -----------------------------------------------------------------------------
# [backend] Rate limiting (per IP, layered under the per-phone OTP limit)
# -----------------------------------------------------------------------------
# Set to false ONLY in automated tests. Never in production.
RATE_LIMIT_ENABLED=true
# Crude flood guard across every endpoint.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Sign-in and OTP verify — the "guess until it works" endpoints.
# Successful attempts do not count, so a busy office does not lock itself out.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Requesting a code. Each one spends money on an SMS, so the ceiling is low.
# Keyed on the phone number when one was sent, otherwise the IP.
OTP_IP_RATE_LIMIT_WINDOW_MS=3600000
OTP_IP_RATE_LIMIT_MAX=15
# Donor search — the anti-scraping limit. Every page is real names and numbers.
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=60


# -----------------------------------------------------------------------------
# [backend] Database — plain PostgreSQL. No PostGIS, no extensions required.
# -----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Port 5433 matches the Docker setup in the README, which avoids clashing with a native
# PostgreSQL install on 5432. Use 5432 if that port is free on your machine.
DATABASE_URL=postgresql://redexpress:redexpress@localhost:5433/redexpress?schema=public


# -----------------------------------------------------------------------------
# [backend] Auth / JWT
# -----------------------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Access and refresh MUST use different secrets so a leaked access secret cannot mint refreshes.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# bcrypt work factor for staff passwords and OTP code hashes.
BCRYPT_ROUNDS=10


# -----------------------------------------------------------------------------
# [backend] Phone OTP
# -----------------------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
# Max verify attempts against a single code before it is burned.
OTP_MAX_ATTEMPTS=5
# Rate limit: how many codes one phone number may request per window.
OTP_REQUESTS_PER_WINDOW=3
OTP_RATE_LIMIT_WINDOW_MINUTES=15
# Default region for parsing/normalising phone numbers (ISO 3166-1 alpha-2).
DEFAULT_PHONE_REGION=IN


# -----------------------------------------------------------------------------
# [backend] SMS provider
# -----------------------------------------------------------------------------
# "console" prints the OTP to the server log — use in development only.
# "msg91"   sends real SMS via MSG91.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
# Approved 6-character sender ID, e.g. REDEXP
MSG91_SENDER_ID=
# MSG91 template ID for the OTP message.
MSG91_TEMPLATE_ID=
MSG91_ROUTE=4


# -----------------------------------------------------------------------------
# [backend] Push notifications (Expo)
# -----------------------------------------------------------------------------
# "console" prints each notification to the server log instead of sending it.
# "expo"    delivers for real via the Expo push service.
# Expo Go CANNOT receive pushes — real delivery needs a device running an EAS dev
# build or a production build. See backend/docs/notifications.md.
PUSH_PROVIDER=console
# Access token from expo.dev -> Account Settings -> Access Tokens.
# Required only when the Expo project has push security enabled.
EXPO_ACCESS_TOKEN=
# How many push messages per chunk sent to the Expo API. Expo's own limit is 100;
# a smaller number here only makes the chunks smaller.
EXPO_PUSH_CHUNK_SIZE=100
# Android notification channel the app creates at startup. Its importance — not
# anything the server sends — decides whether the phone makes a sound.
PUSH_ANDROID_CHANNEL_ID=blood-requests
# Expo discards an undelivered message after this long. A blood request that
# surfaces six hours late is worse than one that never arrives.
PUSH_TTL_SECONDS=3600
# Second-stage delivery check: reads Expo receipts and deletes tokens whose app
# was uninstalled. Expo asks that receipts not be polled immediately, hence the delay.
PUSH_CHECK_RECEIPTS=true
PUSH_RECEIPT_DELAY_MS=900000


# -----------------------------------------------------------------------------
# [backend] File storage (profile photos)
# -----------------------------------------------------------------------------
# "local" writes to disk (development); "s3" uses any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_BYTES=2097152
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,application/pdf
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN/base URL that fronts the bucket.
S3_PUBLIC_BASE_URL=


# -----------------------------------------------------------------------------
# [backend] Matching engine
# -----------------------------------------------------------------------------
# Radii tried in order (smallest first) until MATCH_MIN_CANDIDATES donors are found.
# The walk stops at the first radius that reaches the minimum, so a dense city notifies
# the neighbourhood rather than the whole district.
MATCH_RADII_KM=5,10,25,50
MATCH_MIN_CANDIDATES=20
# Hard ceiling on matches per request — the last radius step can overshoot badly, and
# every match becomes a push notification.
MATCH_MAX_CANDIDATES=100
# "radius" = geo matching (default). "area" = fall back to state/district/city matching.
# A request with no coordinates always uses "area", whatever this says.
MATCH_STRATEGY=radius

# Default lifetime of a blood request, in hours, and the ceiling a client may ask for.
REQUEST_DEFAULT_EXPIRY_HOURS=24
REQUEST_MAX_EXPIRY_HOURS=336
REQUEST_MAX_UNITS=20


# -----------------------------------------------------------------------------
# [backend] Donor search
# -----------------------------------------------------------------------------
SEARCH_DEFAULT_PAGE_SIZE=20
SEARCH_MAX_PAGE_SIZE=100
# Used when a caller sends lat/lng without a radius.
SEARCH_DEFAULT_RADIUS_KM=25
SEARCH_MAX_RADIUS_KM=500
# Cap on bounding-box rows pulled into memory for the exact Haversine pass. Hitting it
# sets "truncated": true in the response rather than silently reporting a partial total.
SEARCH_MAX_CANDIDATE_ROWS=2000


# -----------------------------------------------------------------------------
# [backend] Geocoding (turning a typed address into lat/lng)
# -----------------------------------------------------------------------------
# "none"      disables server-side geocoding; the client must supply lat/lng.
# "nominatim" free OpenStreetMap lookup — no key, but rate-limited to ~1 req/s.
#             Its usage policy requires the identifying User-Agent below.
# "google"    Google Geocoding API; needs GEOCODER_API_KEY.
GEOCODER_PROVIDER=none
GEOCODER_API_KEY=
GEOCODER_TIMEOUT_MS=5000
GEOCODER_USER_AGENT=RedExpress/0.1 (blood donation platform)
# Appended to addresses that do not name a country.
GEOCODER_DEFAULT_COUNTRY=India


# -----------------------------------------------------------------------------
# [backend] Seeding
# -----------------------------------------------------------------------------
# Credentials for the initial ADMIN created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@redexpress.local
SEED_ADMIN_PASSWORD=change-me-before-production
SEED_STAFF_PASSWORD=change-me-before-production


# -----------------------------------------------------------------------------
# [mobile] Expo app  ->  mobile/.env
# -----------------------------------------------------------------------------
# Base URL of the backend as reachable FROM THE DEVICE.
# localhost points at the phone itself, so on a physical device use your machine's
# LAN IP (e.g. http://192.168.1.20:4000); on the Android emulator use 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# Expo project ID (from app.json / eas.json) — needed to fetch a push token.
EXPO_PUBLIC_PROJECT_ID=
# Shown on the privacy/consent screen and behind the registration terms checkbox.
# Leave a URL blank and the app says the document is not in this build and offers the
# support address instead — better than a button that opens a 404.
EXPO_PUBLIC_SUPPORT_EMAIL=support@redexpress.local
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
# Feature flag for the optional voice-input experiment (needs an Expo dev build).
EXPO_PUBLIC_ENABLE_VOICE_INPUT=false


# -----------------------------------------------------------------------------
# [crm] Next.js dashboard  ->  crm/.env.local
# -----------------------------------------------------------------------------
# Server-side base URL used by route handlers to reach the backend.
# Unprefixed, so it stays out of the browser bundle.
BACKEND_API_BASE_URL=http://localhost:4000
# Public origin of the CRM itself; must appear in the backend's CORS_ORIGINS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign the CSRF token on the login/logout route handlers.
# Required in production — the app refuses to start signing tokens without it.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_SESSION_SECRET=replace-me-with-a-long-random-string
# Set to "true" behind HTTPS so session cookies are marked Secure.
CRM_COOKIE_SECURE=false
# Extra origins Server Actions may be invoked from — hostnames only, comma separated,
# no scheme (e.g. crm.example.org). Needed only when a proxy or CDN sits in front, so
# the host Next sees differs from the one the browser used. Empty = same origin only.
CRM_ALLOWED_ORIGINS=
# Stable key for Server Action closure encryption. REQUIRED when running more than one
# CRM instance behind a load balancer — without it each instance generates its own and
# actions fail intermittently on whichever instance did not build the page.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
