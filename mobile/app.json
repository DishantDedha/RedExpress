{
  "expo": {
    "name": "Red Express",
    "slug": "red-express",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "redexpress",
    "backgroundColor": "#F7F7F9",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.redexpress.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.redexpress.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B00020"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Red Express uses your location to find blood donors near you, and to alert you when someone nearby needs your blood group."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Red Express needs access to your photos so you can add a profile picture to your donor record.",
          "cameraPermission": "Red Express needs your camera so you can take a profile picture for your donor record.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B00020",
          "defaultChannel": "blood-requests"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#B00020"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "a9e934be-707a-4317-a2fb-2351bb17ff98"
      },
      "router": {}
    },
    "owner": "dishantdedha"
  }
}
