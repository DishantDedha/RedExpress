# Normalise line endings so a Windows checkout cannot ship CRLF to a Linux server.
* text=auto

# These are executed by Linux, not read by an editor. A CRLF shell script fails with
# "bash\r: No such file or directory", and a CRLF systemd unit is rejected with an error
# that names neither the file nor the reason — so both are pinned to LF regardless of
# the platform they were authored on.
*.sh              text eol=lf
*.service         text eol=lf
*.conf            text eol=lf
deploy/**         text eol=lf

# Binary: never touched, never diffed as text.
*.png             binary
*.jpg             binary
*.pem             binary
*.keystore        binary
